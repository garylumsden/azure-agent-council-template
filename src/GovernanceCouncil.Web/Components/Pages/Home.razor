@page "/"
@using GovernanceCouncil.Core.Interfaces
@using GovernanceCouncil.Core.Models
@inject IAssessmentStore AssessmentStore
@inject IDossierStore DossierStore
@inject INexusStore NexusStore

<PageTitle>@Brand.AppName — Home</PageTitle>

<div class="home-page">
    <header class="gc-page-header">
        <div>
            <h1 class="gc-page-title">@Brand.AppName</h1>
            <p class="gc-page-description">@Brand.Tagline</p>
            @if (Brand.HasOrganisation)
            {
                <p class="gc-meta home-organisation">@Brand.Organisation</p>
            }
        </div>
        <div class="gc-action-group">
            <FluentAnchor Href="/dossiers" Appearance="Appearance.Accent">Choose a dossier</FluentAnchor>
        </div>
    </header>

    <nav class="gc-toolbar home-shortcuts" aria-label="Explore council records">
        <a href="/dossiers">Dossiers <span class="home-count">@(_documentCount?.ToString() ?? "…")</span></a>
        <a href="/assessments">Assessments <span class="home-count">@(_assessmentCount?.ToString() ?? "…")</span></a>
        <a href="/nexus">Nexus alerts <span class="home-count">@(_nexusCount?.ToString() ?? "…")</span></a>
    </nav>

    <section class="home-recent" aria-labelledby="recent-assessments-heading">
        <div class="gc-section-header">
            <div>
                <h2 id="recent-assessments-heading">Recent assessments</h2>
                <p class="gc-meta">Review council recommendations or open the dossier behind an assessment.</p>
            </div>
            <a href="/assessments">All assessments →</a>
        </div>
        @if (_recentAssessments is null)
        {
            <div class="gc-empty-state" role="status" aria-live="polite">Loading recent assessments…</div>
        }
        else if (!_recentAssessments.Any())
        {
            <div class="gc-empty-state gc-surface">
                <h3>No assessments yet</h3>
                <p>Choose a dossier from the library, or upload one, to start a council deliberation.</p>
                <FluentAnchor Href="/dossiers" Appearance="Appearance.Accent">Open dossier library</FluentAnchor>
            </div>
        }
        else
        {
            <ul class="gc-surface home-assessment-list">
                @foreach (var assessment in _recentAssessments)
                {
                    <li class="gc-list-row home-assessment" @key="assessment.AssessmentId">
                        <div class="home-assessment-main">
                            <h3><a href="/dossier/@assessment.DossierId">@assessment.DossierTitle</a></h3>
                            <a class="home-assessment-link" href="/assessment/@assessment.AssessmentId">Assessment @assessment.AssessmentId →</a>
                        </div>
                        <div class="home-assessment-result">
                            <span class="gc-pill @UiStyles.StanceClass(assessment.OverallRecommendation)">@assessment.OverallRecommendation</span>
                            <time class="gc-meta" datetime="@assessment.ReviewDate.ToString("yyyy-MM-dd")">@assessment.ReviewDate.ToString("dd MMM yyyy")</time>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>

    <footer class="home-tools gc-toolbar" aria-label="Foundry tools">
        <span class="home-tools-label">Foundry tools</span>
        <a href="@_foundryPortalUrl" target="_blank" rel="noopener noreferrer">Foundry portal ↗</a>
        <a href="http://localhost:4319" target="_blank" rel="noopener noreferrer">Local playground ↗</a>
        <span class="gc-meta">Agents · traces · evaluations</span>
    </footer>
</div>

@code {
    private int? _assessmentCount;
    private int? _documentCount;
    private int? _nexusCount;
    private IReadOnlyList<Assessment>? _recentAssessments;
    private string _foundryPortalUrl = "";

    protected override async Task OnInitializedAsync()
    {
        // Build Foundry portal URL from environment
        var projectName = Environment.GetEnvironmentVariable("AZURE_AI_PROJECT_NAME") ?? "";
        var resourceName = Environment.GetEnvironmentVariable("AI_SERVICES_RESOURCE_NAME") ?? "";
        _foundryPortalUrl = $"https://ai.azure.com/build/agents?wsid=/subscriptions/{Environment.GetEnvironmentVariable("AZURE_SUBSCRIPTION_ID")}/resourceGroups/{Environment.GetEnvironmentVariable("AZURE_RESOURCE_GROUP")}/providers/Microsoft.CognitiveServices/accounts/{resourceName}/projects/{projectName}";

        var assessments = await AssessmentStore.ListAsync();
        _assessmentCount = assessments.Count;
        _recentAssessments = assessments.OrderByDescending(a => a.ReviewDate).Take(10).ToList();

        var documents = await DossierStore.ListAsync();
        _documentCount = documents.Count;

        var nexuses = await NexusStore.ListAllAsync();
        _nexusCount = nexuses.Count;
    }
}
