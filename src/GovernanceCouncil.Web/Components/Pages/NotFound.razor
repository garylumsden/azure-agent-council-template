@page "/not-found"
@layout MainLayout

<PageTitle>Page not found — @Brand.AppName</PageTitle>

<section class="gc-recovery" aria-labelledby="not-found-title">
    <header class="gc-page-header">
        <div>
            <h1 id="not-found-title" class="gc-page-title">Page not found</h1>
            <p class="gc-page-description">This address does not match a page. Check the address, or continue from the dashboard.</p>
        </div>
    </header>

    <div class="gc-action-group">
        <a href="/" class="btn btn-primary">Return to dashboard</a>
        <a href="/dossiers" class="btn btn-outline-secondary">Browse dossiers</a>
    </div>

    <div class="gc-recovery-details">
        <h2>Looking for a document?</h2>
        <p>Open the dossier library to find source documents and start a deliberation.</p>
    </div>
</section>