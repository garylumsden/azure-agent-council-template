@page "/dossiers"
@using GovernanceCouncil.Core.Interfaces
@using GovernanceCouncil.Core.Models
@using GovernanceCouncil.Agents.Ingestion
@using GovernanceCouncil.Agents.Orchestration
@using Microsoft.AspNetCore.Components.Forms
@inject IDossierStore DossierStore
@inject IDossierBlobService BlobService
@inject DossierIngestionService IngestionService
@inject CouncilOrchestrator Orchestrator
@inject GovernanceCouncil.Agents.Provisioning.RaiPolicyManager RaiPolicy
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Dossier library — @Brand.AppName</PageTitle>

<div class="dossier-library">
    <header class="gc-page-header">
        <div>
            <h1 class="gc-page-title">Dossier library</h1>
            <p class="gc-page-description">Choose a dossier to start a council deliberation, or upload a Markdown file.</p>
        </div>
        <div class="gc-action-group">
            <FluentButton Appearance="Appearance.Accent" OnClick="ToggleUpload"
                          aria-expanded="@(_showUpload ? "true" : "false")" aria-controls="dossier-upload">
                @(_showUpload ? "Close upload" : "Upload dossier")
            </FluentButton>
        </div>
    </header>

    <section id="dossier-upload" class="gc-surface upload-panel" hidden="@(!_showUpload)" aria-labelledby="upload-heading">
        <div class="gc-section-header">
            <h2 id="upload-heading">Upload a dossier</h2>
        </div>
        <div class="upload-fields">
            <div class="library-field">
                <FluentTextField @ref="_titleInput" Label="Dossier title" @bind-Value="_mdFileTitle" Immediate="true" Required="true"
                                 Disabled="@_uploadingMd" />
            </div>
            <div class="library-field">
                <label for="markdown-file">Markdown file</label>
                <InputFile @key="_fileInputVersion" id="markdown-file" OnChange="OnMdFileSelected" class="form-control"
                           accept=".md,.markdown,.txt" disabled="@_uploadingMd" aria-describedby="upload-file-help" />
                <p id="upload-file-help" class="gc-meta field-help">.md, .markdown or .txt · Up to 10 MB</p>
            </div>
            <div class="upload-action">
                <FluentButton Appearance="Appearance.Accent" OnClick="UploadMdFile"
                              Disabled="@(_uploadingMd || _selectedMdFile is null || string.IsNullOrWhiteSpace(_mdFileTitle))">
                    @(_uploadingMd ? "Uploading…" : "Upload file")
                </FluentButton>
            </div>
        </div>
    </section>

    <section class="gc-surface library-setup" aria-label="Council settings">
        <FluentAccordion>
            <FluentAccordionItem HeadingLevel="2">
                <HeadingTemplate>
                    <span class="settings-summary">
                        <span class="settings-title">Council settings</span>
                        <span class="gc-meta settings-active">
                            @CouncilModels.ProfileDisplayName · @Grounding.DisplayName(Grounding.Active) · @AgentRuntime.DisplayName(AgentRuntime.Active)
                        </span>
                        <span class="gc-meta">Content safety: @(_currentSafetyKnown ? SafetyLabel(_currentSafety) : "Unknown")</span>
                        @if (SafetyChanged)
                        {
                            <span class="gc-pill badge-conditions">Next: @SafetyLabel(_selectedViolence)</span>
                        }
                    </span>
                </HeadingTemplate>
                <ChildContent>
                    <div class="settings-content">
                        <div class="settings-fields">
                            <div class="library-field">
                                <FluentSelect TOption="CouncilModels.ModelProfile" Label="Model profile" Items="@CouncilModels.AllProfiles"
                                              OptionText="@(profile => CouncilModels.DisplayName(profile))"
                                              OptionValue="@(profile => profile.ToString())" @bind-SelectedOption="_selectedProfile"
                                              Disabled="@(_applying || DossierActionInProgress)" />
                                <p class="gc-meta field-help">The model set used by the council.</p>
                            </div>
                            <div class="library-field">
                                <FluentSelect TOption="Grounding.Provider" Label="Grounding provider" Items="@Grounding.AllProviders"
                                              OptionText="@(provider => Grounding.DisplayName(provider))"
                                              OptionValue="@(provider => provider.ToString())" @bind-SelectedOption="_selectedProvider"
                                              Disabled="@(_applying || DossierActionInProgress)" />
                                <p class="gc-meta field-help">Each agent uses its authoritative domains; the Chair gets them all.</p>
                            </div>
                            <div class="library-field">
                                <FluentSelect TOption="AgentRuntime.Mode" Label="Agent runtime" Items="@AgentRuntime.AllModes"
                                              OptionText="@(runtime => AgentRuntime.DisplayName(runtime))"
                                              OptionValue="@(runtime => runtime.ToString())" @bind-SelectedOption="_selectedRuntime"
                                              Disabled="@(_applying || DossierActionInProgress)" />
                                <p class="gc-meta field-help">Foundry Prompt Agents or local Microsoft Agent Framework agents.</p>
                            </div>
                        </div>
                        <div class="settings-apply">
                            <FluentButton Appearance="Appearance.Neutral" OnClick="ApplySettingsAsync"
                                          Disabled="@(_applying || DossierActionInProgress || !SettingsChanged)">
                                @(_applying ? "Applying…" : "Apply & re-provision")
                            </FluentButton>
                            <p class="gc-meta">Re-provisions all council agents and takes a few seconds. Changes are in memory and reset on restart. <strong>Avoid switching during an active debate.</strong></p>
                        </div>

                        <div class="safety-settings">
                            <div class="library-field">
                                <FluentSelect TOption="string" Label="Safety for next deliberation" @bind-Value="_selectedViolence"
                                              Disabled="@DossierActionInProgress" aria-describedby="safety-help">
                                    @if (!_currentSafetyKnown)
                                    {
                                        <FluentOption Value="">Unchanged (current policy)</FluentOption>
                                    }
                                    <FluentOption Value="Low">Strict</FluentOption>
                                    <FluentOption Value="Medium">Standard</FluentOption>
                                    <FluentOption Value="High">Relaxed</FluentOption>
                                </FluentSelect>
                                <p class="gc-meta field-help">Current policy: @(_currentSafetyKnown ? SafetyLabel(_currentSafety) : "Unknown")</p>
                            </div>
                            <div id="safety-help" class="safety-help">
                                <p><strong>Content safety changes the account-global policy</strong> for every app using this Azure AI account.</p>
                                <p class="gc-meta">A changed selection is confirmed and applied when the next deliberation starts, not by the Apply button above. It takes a few seconds. Use this as a single-presenter control; do not run concurrent deliberations.</p>
                            </div>
                        </div>
                    </div>
                </ChildContent>
            </FluentAccordionItem>
        </FluentAccordion>
    </section>

    @if (_settingsMessage is not null)
    {
        <div class="alert @(_settingsFailed ? "alert-danger" : _applying ? "alert-info" : "alert-success")"
             role="@(_settingsFailed ? "alert" : "status")">@_settingsMessage</div>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-info")"
             role="@(_messageIsError ? "alert" : "status")">@_message</div>
    }

    <section class="library-dossiers" aria-labelledby="dossiers-heading">
        <div class="gc-section-header">
            <h2 id="dossiers-heading">All dossiers</h2>
            @if (_dossiers is not null)
            {
                <span class="gc-meta">@_dossiers.Count @(_dossiers.Count == 1 ? "dossier" : "dossiers")</span>
            }
        </div>
        @if (_dossiers is null)
        {
            <div class="gc-empty-state" role="status" aria-live="polite">Loading dossiers…</div>
        }
        else if (!_dossiers.Any())
        {
            <div class="gc-empty-state gc-surface">
                <h3>No dossiers yet</h3>
                <p>Upload a Markdown file to give the council a document to deliberate.</p>
                @if (!_showUpload)
                {
                    <FluentButton Appearance="Appearance.Accent" OnClick="ToggleUpload" aria-controls="dossier-upload">Upload a dossier</FluentButton>
                }
            </div>
        }
        else
        {
            <ul class="gc-surface dossier-list">
                @foreach (var dossier in _dossiers)
                {
                    <li class="gc-list-row dossier-row" @key="dossier.DossierId">
                        <div class="dossier-summary">
                            <h3><a href="/dossier/@dossier.DossierId">@dossier.Title</a></h3>
                            <div class="gc-meta dossier-meta">
                                <span>@dossier.DossierId</span>
                                <span class="gc-pill badge-abstain">@dossier.Source</span>
                                <span>Uploaded <time datetime="@dossier.UploadedDate.ToString("O")">@dossier.UploadedDate.ToString("dd MMM yyyy")</time></span>
                            </div>
                        </div>
                        <div class="gc-action-group dossier-actions" role="group" aria-label="@($"Actions for {dossier.Title}")">
                            <FluentButton Appearance="Appearance.Accent" OnClick="@(() => SubmitDeliberation(dossier.DossierId))"
                                          Disabled="@(_applying || DossierActionInProgress)">
                                @(_startingDossierId == dossier.DossierId ? "Starting…" : "Deliberate")
                            </FluentButton>
                            <FluentAnchor Href="@($"/dossier/{dossier.DossierId}")" Appearance="Appearance.Neutral">View</FluentAnchor>
                            <FluentButton Appearance="Appearance.Stealth" OnClick="@(() => DeleteDossier(dossier))" Disabled="@DossierActionInProgress">
                                @(_deletingDossierId == dossier.DossierId ? "Deleting…" : "Delete")
                            </FluentButton>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
</div>

@code {
    private IReadOnlyList<Dossier>? _dossiers;
    private string _message = "";
    private bool _uploadingMd;
    private bool _showUpload;
    private bool _focusUpload;
    private FluentTextField? _titleInput;
    private bool _messageIsError;
    private bool _settingsFailed;
    private int _fileInputVersion;
    private string? _startingDossierId;
    private string? _deletingDossierId;

    private bool DossierActionInProgress => _startingDossierId is not null || _deletingDossierId is not null;
    private bool SafetyChanged => !string.IsNullOrEmpty(_selectedViolence)
        && !string.Equals(_selectedViolence, _currentSafety, StringComparison.OrdinalIgnoreCase);
    private IBrowserFile? _selectedMdFile;
    private string _mdFileTitle = "";

    private CouncilModels.ModelProfile _selectedProfile = CouncilModels.Profile;
    private Grounding.Provider _selectedProvider = Grounding.Active;
    private AgentRuntime.Mode _selectedRuntime = AgentRuntime.Active;
    // Per-deliberation content-safety strictness toggle. Values map Low=Strict / Medium=Standard /
    // High=Relaxed. "" = leave the policy unchanged (no control-plane call).
    private string _selectedViolence = "";
    // The live policy level read from the control plane on load, so the presenter sees the current state.
    private string? _currentSafety;
    private bool _currentSafetyKnown;
    private bool _applying;
    private string? _settingsMessage;

    // Generic, category-free demo labels for the content-safety strictness levels.
    private static string SafetyLabel(string? level) => (level ?? "").Trim().ToLowerInvariant() switch
    {
        "low" => "Strict",
        "medium" => "Standard",
        "high" => "Relaxed",
        _ => "Unknown"
    };

    private bool SettingsChanged =>
        _selectedProfile != CouncilModels.Profile
        || _selectedProvider != Grounding.Active
        || _selectedRuntime != AgentRuntime.Active;

    private async Task ApplySettingsAsync()
    {
        if (_applying || DossierActionInProgress || !SettingsChanged) return;
        _applying = true;
        _settingsFailed = false;
        _settingsMessage = "Re-provisioning the council…";
        StateHasChanged();
        try
        {
            await Orchestrator.ApplySettingsAsync(_selectedProfile, _selectedProvider, _selectedRuntime);
            _settingsMessage =
                $"Now running the {CouncilModels.DisplayName(_selectedProfile)} profile · " +
                $"{Grounding.DisplayName(_selectedProvider)} grounding · " +
                $"{AgentRuntime.DisplayName(_selectedRuntime)}.";
        }
        catch (Exception ex)
        {
            _settingsFailed = true;
            _settingsMessage = $"Could not apply council settings: {ex.Message}. Review the selections and try again.";
        }
        finally
        {
            _applying = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _dossiers = await DossierStore.ListAsync();
        _showUpload = _dossiers.Count == 0;

        // Read the live content-safety level from the control plane so the presenter sees the current
        // setting and the dropdown reflects it. Best-effort: unavailable (local run / no RBAC) ⇒ Unknown.
        try
        {
            _currentSafety = await RaiPolicy.GetCurrentThresholdAsync();
            if (!string.IsNullOrWhiteSpace(_currentSafety))
            {
                _currentSafetyKnown = true;
                _selectedViolence = _currentSafety;
            }
        }
        catch { /* leave as Unknown / Unchanged */ }
    }

    private void ToggleUpload()
    {
        _showUpload = !_showUpload;
        _focusUpload = _showUpload;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusUpload && _titleInput is not null)
        {
            _focusUpload = false;
            _titleInput.FocusAsync();
        }
        return Task.CompletedTask;
    }

    private void OnMdFileSelected(InputFileChangeEventArgs e)
    {
        _selectedMdFile = e.File;
        if (string.IsNullOrWhiteSpace(_mdFileTitle))
        {
            _mdFileTitle = TitleFromFilename(_selectedMdFile.Name);
        }
    }

    private async Task UploadMdFile()
    {
        if (_uploadingMd || _selectedMdFile is null || string.IsNullOrWhiteSpace(_mdFileTitle)) return;
        _uploadingMd = true;
        _message = "";
        _messageIsError = false;
        try
        {
            using var reader = new StreamReader(_selectedMdFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
            var markdown = await reader.ReadToEndAsync();
            var dossier = await IngestionService.UploadMarkdownAsync(markdown, _mdFileTitle);
            _message = $"Dossier '{dossier.Title}' created from file (ID: {dossier.DossierId}).";
            _dossiers = await DossierStore.ListAsync();
            _mdFileTitle = "";
            _selectedMdFile = null;
            _fileInputVersion++;
        }
        catch (Exception ex)
        {
            _messageIsError = true;
            _message = $"Upload failed: {ex.Message}. Check the file and try again.";
        }
        finally
        {
            _uploadingMd = false;
        }
    }

    private async Task SubmitDeliberation(string dossierId)
    {
        if (_applying || DossierActionInProgress) return;
        _startingDossierId = dossierId;
        _message = "";
        _messageIsError = false;

        try
        {
            var deliberationId = $"DL-{DateTime.UtcNow:yyyy}-{Guid.NewGuid().ToString("N")[..8]}";

            // Only pass the content-safety level when the presenter actually changed it from the live
            // value — otherwise there's nothing to apply (no control-plane call, no "applying" delay).
            var changed = SafetyChanged;

            // The content-safety policy is account-global: it affects every application that uses
            // this Azure AI account, not just this deliberation. Require an explicit confirmation.
            if (changed)
            {
                var confirmed = await JS.InvokeAsync<bool>("confirm",
                    $"Change the content-safety policy from {SafetyLabel(_currentSafety)} to {SafetyLabel(_selectedViolence)}?\n\n" +
                    "This changes the ACCOUNT-GLOBAL Azure AI policy and affects every application " +
                    "that uses this Azure AI account. Continue?");

                if (!confirmed)
                {
                    _message = "Content-safety change cancelled. The deliberation was not started.";
                    return;
                }
            }

            // Create the record as Pending. The live page starts the debate AFTER it has joined the
            // SignalR group, so the viewer never misses the opening phases (Independent Assessment).
            await Orchestrator.CreateDeliberationRecordAsync(dossierId, deliberationId);

            var safetyQuery = changed ? $"&cs={Uri.EscapeDataString(_selectedViolence)}" : "";
            Navigation.NavigateTo($"/deliberation/{deliberationId}/live?dossierId={dossierId}{safetyQuery}");
        }
        catch (Exception ex)
        {
            _messageIsError = true;
            _message = $"Could not start deliberation: {ex.Message}. Try again.";
        }
        finally
        {
            _startingDossierId = null;
        }
    }

    private static string TitleFromFilename(string filename)
    {
        var name = System.IO.Path.GetFileNameWithoutExtension(filename);
        name = name.Replace('-', ' ').Replace('_', ' ').Replace('.', ' ');
        return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(name.ToLower());
    }

    private async Task DeleteDossier(Dossier dossier)
    {
        if (DossierActionInProgress) return;
        _deletingDossierId = dossier.DossierId;
        _message = "";
        _messageIsError = false;
        try
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm",
                $"Delete '{dossier.Title}'?\n\nThis permanently deletes the dossier and its stored files. This cannot be undone.");
            if (!confirmed) return;

            // Delete blobs
            if (!string.IsNullOrEmpty(dossier.OriginalBlobPath))
                await BlobService.DeleteBlobAsync(dossier.OriginalBlobPath);
            if (!string.IsNullOrEmpty(dossier.MarkdownBlobPath))
                await BlobService.DeleteBlobAsync(dossier.MarkdownBlobPath);

            // Delete Cosmos record
            await DossierStore.DeleteAsync(dossier.DossierId);

            _message = $"Deleted '{dossier.Title}'.";
            _dossiers = await DossierStore.ListAsync();
        }
        catch (Exception ex)
        {
            _messageIsError = true;
            _message = $"Delete failed: {ex.Message}. Try again.";
        }
        finally
        {
            _deletingDossierId = null;
        }
    }
}
