@using GovernanceCouncil.Core.Models
@using Markdig
@using Markdig.Renderers

<div class="gc-debate-markdown">@_html</div>

@code {
    [Parameter] public string? Text { get; set; }

    private static readonly MarkdownPipeline _mdPipeline = CreatePipeline();
    private string? _previousText;
    private MarkupString _html;

    private static MarkdownPipeline CreatePipeline()
    {
        var builder = new MarkdownPipelineBuilder().UseAdvancedExtensions().DisableHtml();
        // DisableHtml blocks raw tags, but these extensions can still emit arbitrary
        // attributes, embedded media or diagram markup from otherwise ordinary Markdown.
        builder.Extensions.TryRemove<Markdig.Extensions.GenericAttributes.GenericAttributesExtension>();
        builder.Extensions.TryRemove<Markdig.Extensions.MediaLinks.MediaLinkExtension>();
        builder.Extensions.TryRemove<Markdig.Extensions.Diagrams.DiagramExtension>();
        return builder.Build();
    }

    protected override void OnParametersSet()
    {
        // Hands and moderator events also update parameters. Parse only changed prose.
        if (string.Equals(_previousText, Text, StringComparison.Ordinal)) return;
        _previousText = Text;
        if (string.IsNullOrWhiteSpace(Text))
        {
            _html = default;
            return;
        }

        using var writer = new System.IO.StringWriter();
        var renderer = new Markdig.Renderers.HtmlRenderer(writer) { LinkRewriter = SafeUrl };
        _mdPipeline.Setup(renderer);
        renderer.Render(Markdown.Parse(ModelText.StripSourceAnnotations(Text), _mdPipeline));
        _html = (MarkupString)writer.ToString();
    }

    private static string SafeUrl(string url)
    {
        if (string.IsNullOrWhiteSpace(url) || url.Any(char.IsControl)) return "#";
        if (Uri.TryCreate(url, UriKind.Absolute, out var absolute))
            return absolute.Scheme is "https" or "http" or "mailto" ? url : "#";

        // Keep document-relative links and footnote anchors, but not obfuscated schemes.
        return !url.Contains(':') && !url.Contains('\\') && Uri.IsWellFormedUriString(url, UriKind.Relative)
            ? url : "#";
    }
}
