# azd postprovision generates .env from this file, expanding ${VAR} and ${VAR:-default}
# from azd outputs / environment. To run WITHOUT azd: copy to .env and replace the
# ${...} placeholders with your own values. Commented lines pass through verbatim.

AZURE_TENANT_ID=${AZURE_TENANT_ID}
AZURE_SUBSCRIPTION_ID=${AZURE_SUBSCRIPTION_ID}
AZURE_RESOURCE_GROUP=${AZURE_RESOURCE_GROUP}
AZURE_AI_FOUNDRY_ENDPOINT=${AZURE_AI_FOUNDRY_ENDPOINT}
AZURE_AI_SERVICES_ENDPOINT=${AZURE_AI_SERVICES_ENDPOINT}
AZURE_OPENAI_ENDPOINT=${AZURE_OPENAI_ENDPOINT}
AZURE_AI_PROJECT_NAME=${AZURE_AI_PROJECT_NAME}
AI_SERVICES_RESOURCE_NAME=${AI_SERVICES_RESOURCE_NAME}

# --- Models / tiers ---
# Profile: Frontier / Balanced / Fast (default) / Grok.
COUNCIL_MODEL_PROFILE=${COUNCIL_MODEL_PROFILE:-Fast}
COUNCIL_EMBEDDING_MODEL=${COUNCIL_EMBEDDING_MODEL:-text-embedding-3-small}
EMBEDDING_DEPLOYMENT_NAME=${EMBEDDING_DEPLOYMENT_NAME:-text-embedding-3-small}
# Optional per-tier model overrides (uncomment; each must match a Foundry deployment):
# COUNCIL_REASONING_MODEL=gpt-5-mini
# COUNCIL_SYNTHESIS_MODEL=gpt-5.4
# COUNCIL_FAST_MODEL=gpt-5-mini
# COUNCIL_STRUCTURED_OUTPUTS=   # optional override; auto-off for the Grok profile
# COUNCIL_REASONING_EFFORT=     # optional; empty => per-tier defaults

# --- Debate / nexus tuning ---
COUNCIL_DEBATE_MAX_ROUNDS=${COUNCIL_DEBATE_MAX_ROUNDS:-5}
COUNCIL_NEXUS_TOPK=${COUNCIL_NEXUS_TOPK:-8}
# Phase-1 / bid-round concurrency. Effective = (Web IQ) ? min(MAX, GROUNDING_MAX) : MAX.
# Web IQ has a limited request rate, so GROUNDING_MAX caps grounded fan-out; raise it to speed Phase 1.
COUNCIL_MAX_PARALLELISM=${COUNCIL_MAX_PARALLELISM:-7}
COUNCIL_GROUNDING_MAX_PARALLELISM=${COUNCIL_GROUNDING_MAX_PARALLELISM:-2}

# --- Storage / data ---
COSMOS_DB_ENDPOINT=${COSMOS_DB_ENDPOINT}
COSMOS_DB_DATABASE_NAME=${COSMOS_DB_DATABASE_NAME:-governance-council}
STORAGE_ACCOUNT_NAME=${STORAGE_ACCOUNT_NAME}
SEARCH_SERVICE_ENDPOINT=${SEARCH_SERVICE_ENDPOINT}
SEARCH_SERVICE_NAME=${SEARCH_SERVICE_NAME}
APPINSIGHTS_CONNECTION_STRING=${APPINSIGHTS_CONNECTION_STRING}

# --- Grounding ---
# webiq (default) = Microsoft Web IQ; foundryiq = Foundry IQ knowledge base. Runtime-switchable.
COUNCIL_GROUNDING_PROVIDER=${COUNCIL_GROUNDING_PROVIDER:-webiq}
KNOWLEDGE_BASE_CONNECTION_NAME=${KNOWLEDGE_BASE_CONNECTION_NAME:-kbgcknowledgebase}
WEBIQ_CONNECTION_NAME=${WEBIQ_CONNECTION_NAME:-}
WEBIQ_MCP_URL=${WEBIQ_MCP_URL:-https://api.microsoft.ai/v3/mcp}
# Web IQ key for the LOCAL MAF runtime's in-proc grounding tool (the Foundry path reads it from
# Key Vault). Provide before provisioning with: azd env set WEBIQ_API_KEY <key>
WEBIQ_API_KEY=${WEBIQ_API_KEY:-}
