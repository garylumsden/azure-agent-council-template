# Copy this file to .env and fill in values from `azd up` output
# Or run `azd up` which auto-generates .env via the post-provision hook
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_SERVICES_ENDPOINT=
AZURE_OPENAI_ENDPOINT=
AZURE_AI_PROJECT_NAME=
AI_SERVICES_RESOURCE_NAME=
COUNCIL_MODEL_PROFILE=Fast
# COUNCIL_STRUCTURED_OUTPUTS= # optional; auto-off for the Grok Fast profile
EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small

# --- Optional per-tier overrides (take precedence over the profile). ---
# Each name must match a Foundry model deployment.
# COUNCIL_REASONING_MODEL=gpt-5-mini
# COUNCIL_SYNTHESIS_MODEL=gpt-5.4
# COUNCIL_FAST_MODEL=gpt-5-mini
# Embedding model used for nexus top-K prior retrieval (cosine similarity).
COUNCIL_EMBEDDING_MODEL=text-embedding-3-small
# Max debate rounds before the chair force-concludes (hands-up/bidding loop).
COUNCIL_DEBATE_MAX_ROUNDS=5
# Nexus retrieval: max number of prior assessments fed to the LLM.
COUNCIL_NEXUS_TOPK=8
# Phase-1 / bid-round concurrency. Base cap on parallel model calls (members):
COUNCIL_MAX_PARALLELISM=7
# Tighter cap applied ONLY while Web IQ is the grounding provider (limited RPM — avoids 429s).
# Effective concurrency = Web IQ ? min(MAX, GROUNDING_MAX) : MAX. Raise to speed up Phase 1.
COUNCIL_GROUNDING_MAX_PARALLELISM=2

COSMOS_DB_ENDPOINT=
COSMOS_DB_DATABASE_NAME=governance-council
STORAGE_ACCOUNT_NAME=
SEARCH_SERVICE_ENDPOINT=
SEARCH_SERVICE_NAME=
APPINSIGHTS_CONNECTION_STRING=
# Foundry IQ knowledge base MCP RemoteTool connection name (also the KB name).
# Provisioned by azd (RemoteTool connection) + self-provisioned by the app at first boot
# (Web Knowledge Source + Knowledge Base via Azure.Search.Documents). No portal steps required.
KNOWLEDGE_BASE_CONNECTION_NAME=kbgcknowledgebase

# --- Web grounding provider --------------------------------------------------
# webiq (default) = Microsoft Web IQ; foundryiq = Foundry IQ knowledge base. Runtime-switchable.
COUNCIL_GROUNDING_PROVIDER=webiq
# Web IQ MCP RemoteTool connection name + endpoint (limited access). Empty connection name
# disables the Web IQ tool. Key is held in Key Vault — never put it here.
WEBIQ_CONNECTION_NAME=
WEBIQ_MCP_URL=https://api.microsoft.ai/v3/mcp
