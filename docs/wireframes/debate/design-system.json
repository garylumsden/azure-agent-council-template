    "identity": "Inherited production navy, Segoe UI, blue actions, and gold live states."
  },
  "focusRing": {
    "source": "styles.css",
    "selector": "button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible, main:focus-visible",
    "outline": "2px solid var(--blue)",
    "outlineOffset": "3px"
  },
  "depth": {
    "drawer": {
      "source": "styles.css .inspector",
      "position": "absolute within .workspace-region",
      "width": "min(480px, calc(100% - 56px))",
      "shadow": "-16px 16px 50px rgba(0, 0, 0, .45)",
      "zIndex": 20
    },
    "toast": {
      "source": "styles.css .toast",
      "shadow": "0 8px 28px rgba(0, 0, 0, .35)",
      "zIndex": 40
    }
  },
  "mediaQueries": [
    {
      "query": "(min-width: 1680px)",
      "rules": "15px root font; 40px workspace insets; desk columns 270px minmax(0, 1fr) 320px; response paragraphs 16px; stage paragraphs 18px."
    },
    {
      "query": "(max-width: 1199px)",
      "rules": "Switcher wraps below branding; 20px workspace insets; desk columns 175px minmax(0, 1fr) 190px; three conversation columns."
    },
    {
      "query": "(max-height: 820px) and (min-width: 768px)",
      "rules": "Reduced vertical padding; stage heading 27px; stage paragraphs 15px; transport minimum height 60px."
    },
    {
      "query": "(max-width: 767px)",
      "rules": "100dvh app with no minimum height; 12px workspace insets; horizontal switcher; visible idea count; hidden desk side panels and stage roster.",
      "horizontalPanels": { "hands": "82%", "lanes": "87%", "split": "92%", "timeline": "94%" },
      "scrollSnap": { "hands": "x proximity", "lanesSplitTimeline": "x mandatory" },
      "handReasons": { "fontSize": "12px", "lineHeight": 1.45, "hint": "Swipe to see each reason →" },
      "responseText": { "headingSize": "22px", "paragraphSize": "14px", "paragraphLineHeight": 1.7 },
      "drawer": { "right": "12px", "bottom": "8px", "width": "calc(100% - 24px)", "radius": "8px" },
      "transportBottomPadding": "max(6px, env(safe-area-inset-bottom))"
    },
    {
      "query": "(max-width: 767px) and (max-height: 690px)",
      "rules": "Hidden session path; Moderator maximum height 76px with vertical scrolling; hand minimum height 61px."
    }
  ],
  "motion": {
    "source": "styles.css @media (prefers-reduced-motion: no-preference)",
    "handTransition": { "selector": ".hand-request", "value": "background-color 160ms ease-out, border-color 160ms ease-out" },
    "floorArrival": {
      "selector": ".on-floor .avatar",
      "animation": "floor-arrival 240ms cubic-bezier(.16, 1, .3, 1)",
      "fromShadow": "0 0 0 6px rgba(136, 184, 255, .15)",
      "toShadow": "0 0 0 0 transparent"
    },
    "reducedMotion": "These CSS transitions and animations apply only when no reduced-motion preference is set."
  },
  "codeReferences": {
    "tokensAndType": "styles.css :root; h1; .response-prose; .spotlight-article",
    "layout": "styles.css .app; .workspace-region; .desk-layout; .stage-layout; .lanes-layout; .split-layout; .timeline-layout",
    "mobileDiscovery": "index.html #idea-position; .mobile-hands-hint; styles.css mobile media rules",
    "directionContract": "index.html opening THESIS, OWN-WORLD, STORY, FIRST VIEWPORT, and FORM comments",
    "regionsAndControls": "index.html .moderator-strip; #workspace; #inspector; .hand-shelf; .transport",
    "interactionDocumentation": "README.md: Compare the five ideas; Interactions; Scope and attribution",
    "simulationImplementation": "app.js",
    "syntheticData": "fixture.js"
